  · exact nonsingleton2_polynomial_pos t (by norm_num; linarith [h1]) (by simpa using h2)
  by_cases h3 : t ≤ 1 / 5
  · exact nonsingleton3_polynomial_pos t (by norm_num; linarith [h2]) (by simpa using h3)
  by_cases h4 : t ≤ 1 / 4
  · exact nonsingleton4_polynomial_pos t (by norm_num; linarith [h3]) (by simpa using h4)
  by_cases h5 : t ≤ 3 / 10
  · exact nonsingleton5_polynomial_pos t (by norm_num; linarith [h4]) (by simpa using h5)
  exact nonsingleton6_polynomial_pos t (by norm_num; linarith [h5]) (by simpa using ht1)


private theorem singleton_eval (t : ℝ) : rationalEval (fun _ : Fin 1 ↦ t) singletonPolynomial =
    (6 + t ^ 2) * (24 / 625 : ℝ) *
      (4 * (1 - (cellCorrection : ℝ)) * denominator t - crossingNumerator t) *
      (4 * sixDominationFactor t * denominator t - crossingNumerator t) ^ 5 -
      ((5 / 324 : ℝ) * (6 + t ^ 2) - t ^ 2) * (4 * denominator t) ^ 6 := by
  simp [rationalEval, singletonPolynomial, permanentNumeratorPolynomial, cellFloorPolynomial,
    permanentBasePolynomial, denominatorPolynomial, energyPolynomial, dominationPolynomial,
    heightPolynomial, crossingNumeratorPolynomial, denominator, energy, height,
    crossingNumerator, sixDominationFactor]

private theorem nonsingleton_eval (t : ℝ) : rationalEval (fun _ : Fin 1 ↦ t) nonsingletonPolynomial =
    (6 + t ^ 2) * (3 / 64 : ℝ) *
      (4 * sixDominationFactor t * denominator t - crossingNumerator t) ^ 6 -
      ((5 / 324 : ℝ) * (6 + t ^ 2) - t ^ 2) * (4 * denominator t) ^ 6 := by
  simp [rationalEval, nonsingletonPolynomial, permanentNumeratorPolynomial,
    permanentBasePolynomial, denominatorPolynomial, energyPolynomial, dominationPolynomial,
    heightPolynomial, crossingNumeratorPolynomial, denominator, energy, height,
    crossingNumerator, sixDominationFactor]

private theorem base_clearing (t : ℝ) (hd : denominator t ≠ 0) :
    4 * sixDominationFactor t * denominator t - crossingNumerator t =
      (4 * denominator t) * (sixDominationFactor t - crossingBound t / 2) := by
  unfold crossingBound
  field_simp
  ring

private theorem cell_clearing (t : ℝ) (hd : denominator t ≠ 0) :
    4 * (1 - (cellCorrection : ℝ)) * denominator t - crossingNumerator t =
      (4 * denominator t) * (1 - crossingBound t / 2 - (cellCorrection : ℝ)) := by
  unfold crossingBound
  field_simp
  ring

private theorem permanent_clearing (t : ℝ) :
    (5 / 324 : ℝ) * (6 + t ^ 2) - t ^ 2 =
      (6 + t ^ 2) * ((5 / 324 : ℝ) - t ^ 2 / (6 + t ^ 2)) := by
  have h : 6 + t ^ 2 ≠ 0 := by nlinarith [sq_nonneg t]
  field_simp

def singletonGap (t : ℝ) : ℝ :=
  (1 - crossingBound t / 2 - (cellCorrection : ℝ)) * (24 / 625) *
    (sixDominationFactor t - crossingBound t / 2) ^ 5 -
    ((5 / 324) - t ^ 2 / (6 + t ^ 2))

def nonsingletonGap (t : ℝ) : ℝ :=
  (3 / 64) * (sixDominationFactor t - crossingBound t / 2) ^ 6 -
    ((5 / 324) - t ^ 2 / (6 + t ^ 2))

theorem singleton_cleared (t : ℝ) (hd : denominator t ≠ 0) :
    rationalEval (fun _ : Fin 1 ↦ t) singletonPolynomial =
      ((6 + t ^ 2) * (4 * denominator t) ^ 6) * singletonGap t := by
  rw [singleton_eval, base_clearing t hd, cell_clearing t hd, permanent_clearing]
  unfold singletonGap
  ring

theorem nonsingleton_cleared (t : ℝ) (hd : denominator t ≠ 0) :
    rationalEval (fun _ : Fin 1 ↦ t) nonsingletonPolynomial =
      ((6 + t ^ 2) * (4 * denominator t) ^ 6) * nonsingletonGap t := by
  rw [nonsingleton_eval, base_clearing t hd, permanent_clearing]
  unfold nonsingletonGap
  ring


/-- The singleton permanent floor strictly exceeds the candidate permanent
throughout the closed certificate interval. -/
theorem singleton_gap_pos (t : ℝ) (ht : 0 ≤ t) (ht1 : t ≤ 31 / 100) : 0 < singletonGap t := by
  have hd := denominator_pos t ht ht1
  have h := singleton_polynomial_pos t ht ht1
  rw [singleton_cleared t hd.ne'] at h
  exact pos_of_mul_pos_right h (by positivity)

/-- The non-singleton permanent floor has the same strict comparison. -/
theorem nonsingleton_gap_pos (t : ℝ) (ht : 0 ≤ t) (ht1 : t ≤ 31 / 100) : 0 < nonsingletonGap t := by
  have hd := denominator_pos t ht ht1
  have h := nonsingleton_polynomial_pos t ht ht1
  rw [nonsingleton_cleared t hd.ne'] at h
  exact pos_of_mul_pos_right h (by positivity)

/-- The inverse substitution is exact and keeps its denominator explicit. -/
theorem sixDeficitParameter_inverse {delta : ℝ} (hd0 : 0 ≤ delta) (hd1 : delta < 1) :
    sixDeficitParameter delta ^ 2 / (6 + sixDeficitParameter delta ^ 2) = delta := by
  have hd : 1 - delta ≠ 0 := by linarith
  rw [sixDeficitParameter_sq hd0 hd1]
  field_simp
  ring

theorem singleton_floor_gt_deficit {delta : ℝ} (hd0 : 0 ≤ delta)
    (hdg : delta ≤ dittertConstant 6) :
    dittertConstant 6 - delta <
      (1 - crossingBound (sixDeficitParameter delta) / 2 - (cellCorrection : ℝ)) *
        dittertConstant 5 *
        (sixDominationFactor (sixDeficitParameter delta) -
          crossingBound (sixDeficitParameter delta) / 2) ^ 5 := by
  have hd1 := hdg.trans_lt (dittertConstant_lt_one (by norm_num))
  have h := singleton_gap_pos (sixDeficitParameter delta) (sixDeficitParameter_nonneg delta)
    (sixDeficitParameter_le_cap hd0 hdg).le
  rw [singletonGap, sixDeficitParameter_inverse hd0 hd1] at h
  have hg6 : dittertConstant 6 = 5 / 324 := by norm_num [dittertConstant, Nat.factorial]
  have hg5 : dittertConstant 5 = 24 / 625 := by norm_num [dittertConstant, Nat.factorial]
  rw [hg6, hg5]
  exact sub_pos.mp h

theorem nonsingleton_floor_gt_deficit {delta : ℝ} (hd0 : 0 ≤ delta)
    (hdg : delta ≤ dittertConstant 6) :
    dittertConstant 6 - delta < (3 / 64 : ℝ) *
      (sixDominationFactor (sixDeficitParameter delta) -
        crossingBound (sixDeficitParameter delta) / 2) ^ 6 := by
  have hd1 := hdg.trans_lt (dittertConstant_lt_one (by norm_num))
  have h := nonsingleton_gap_pos (sixDeficitParameter delta) (sixDeficitParameter_nonneg delta)
    (sixDeficitParameter_le_cap hd0 hdg).le
  rw [nonsingletonGap, sixDeficitParameter_inverse hd0 hd1] at h
  have hg6 : dittertConstant 6 = 5 / 324 := by norm_num [dittertConstant, Nat.factorial]
  rw [hg6]
  exact sub_pos.mp h

end
end DittertRybin.Certificates.SpectralSix
