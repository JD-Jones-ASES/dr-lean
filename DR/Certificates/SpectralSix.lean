noncomputable section
open MvPolynomial SpectralSixGuards

def permanentNumeratorPolynomial : MvPolynomial (Fin 1) ℚ :=
  C (5 / 324) * (C 6 + X 0 ^ 2) - X 0 ^ 2
def singletonPolynomial : MvPolynomial (Fin 1) ℚ :=
  (C 6 + X 0 ^ 2) * C (24 / 625) * cellFloorPolynomial * permanentBasePolynomial ^ 5 -
    permanentNumeratorPolynomial * (4 * denominatorPolynomial) ^ 6
def nonsingletonPolynomial : MvPolynomial (Fin 1) ℚ :=
  (C 6 + X 0 ^ 2) * C (3 / 64) * permanentBasePolynomial ^ 6 -
    permanentNumeratorPolynomial * (4 * denominatorPolynomial) ^ 6

