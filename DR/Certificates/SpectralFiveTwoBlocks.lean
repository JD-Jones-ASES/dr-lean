set_option maxRecDepth 16384 in
set_option maxHeartbeats 32000000 in
theorem xAbove_coefficient_identity :
    affineNormalize (fun _ : Fin 2 => 0) (fun _ => 1) xAbovePolynomial =
      tensorPolynomial ![9, 6] (fun a => xAboveCoefficients (a 0) (a 1)) := by
  apply MvPolynomial.funext
  intro z
  rw [tensorPolynomial_two]
  norm_num [affineNormalize, uPolynomial, vPolynomial, ePolynomial, fPolynomial, rPolynomial, sPolynomial, aPolynomial, bPolynomial, mTwoPolynomial, mThreePolynomial, dxPolynomial, dyPolynomial, nxPolynomial, nyPolynomial, xAbovePolynomial, yAbovePolynomial, sumBelowPolynomial, productAbovePolynomial, xAboveCoefficients, Fin.sum_univ_succ,
    Nat.choose_eq_descFactorial_div_factorial, Nat.descFactorial, Nat.factorial]
  try dsimp
  try norm_num
  ring

set_option maxRecDepth 16384 in
set_option maxHeartbeats 32000000 in
theorem xAbove_coefficients_ge_margin (a : BernsteinIndex ![9, 6]) :
    xAboveMargin ≤ xAboveCoefficients (a 0) (a 1) := by
  generalize a 0 = i
  generalize a 1 = j
  fin_cases i <;> fin_cases j <;> decide +kernel

def xAboveCertificate : BernsteinCertificate xAbovePolynomial
    (fun _ => 0) (fun _ => 1) where
  degree := ![9, 6]
  coefficients := fun a => xAboveCoefficients (a 0) (a 1)
  margin := xAboveMargin
  identity := xAbove_coefficient_identity
  coefficient_bound := xAbove_coefficients_ge_margin

theorem xAbove_polynomial_pos (x y : ℝ) (hx : 0 ≤ x) (hx1 : x ≤ 1) (hy : 0 ≤ y) (hy1 : y ≤ 1) :
    0 < rationalEval ![x,y] xAbovePolynomial :=
  xAboveCertificate.pos (by intro i; norm_num)
    (by norm_num [xAboveCertificate, xAboveMargin]) ![x,y]
    (by intro i; fin_cases i <;> norm_num <;> exact ⟨by assumption, by assumption⟩)

