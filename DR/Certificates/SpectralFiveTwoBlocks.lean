/-!
# The exact order-five two-block certificates

The four rational polynomials come from Appendix C of Analytic-Lab P0174
`SQUARE_ENDPOINT_5.md`. Their 500 tensor coefficients certify the whole
triangle u,v≥0, u+v≤13/50 through u=(13/50)x,v=(13/50)(1−x)y.
-/

namespace DittertRybin.Certificates.SpectralFiveTwoBlocks
open scoped BigOperators
open MvPolynomial
noncomputable section

def uPolynomial : MvPolynomial (Fin 2) ℚ := C (13 / 50) * X 0
def vPolynomial : MvPolynomial (Fin 2) ℚ := C (13 / 50) * (1 - X 0) * X 1
def ePolynomial : MvPolynomial (Fin 2) ℚ := C (1 / 2) * (C (13 / 50) - uPolynomial - vPolynomial)
def fPolynomial : MvPolynomial (Fin 2) ℚ := C (1 / 2) * (C (13 / 50) + uPolynomial + vPolynomial)
def rPolynomial : MvPolynomial (Fin 2) ℚ := 1 + C (1 / 3) * uPolynomial
def sPolynomial : MvPolynomial (Fin 2) ℚ := 1 - C (1 / 3) * vPolynomial
def aPolynomial : MvPolynomial (Fin 2) ℚ := 1 - C (1 / 2) * uPolynomial
def bPolynomial : MvPolynomial (Fin 2) ℚ := 1 + C (1 / 2) * vPolynomial
def mTwoPolynomial : MvPolynomial (Fin 2) ℚ := 1 + C (1 / 4) * (vPolynomial - uPolynomial - C (13 / 50))
def mThreePolynomial : MvPolynomial (Fin 2) ℚ := 1 + C (1 / 6) * (uPolynomial - vPolynomial - C (13 / 50))
def dxPolynomial : MvPolynomial (Fin 2) ℚ := rPolynomial ^ 3 * sPolynomial ^ 4
def dyPolynomial : MvPolynomial (Fin 2) ℚ := aPolynomial ^ 3 * bPolynomial ^ 2
def nxPolynomial : MvPolynomial (Fin 2) ℚ :=
  (1 - C (100 / 79) * ePolynomial) * sPolynomial ^ 4 +
    (sPolynomial - fPolynomial) * rPolynomial ^ 3 - C (3 / 2) * mTwoPolynomial ^ 2 * dxPolynomial
def nyPolynomial : MvPolynomial (Fin 2) ℚ :=
  (aPolynomial - fPolynomial) * bPolynomial ^ 2 +
    (1 - C (100 / 79) * ePolynomial) * aPolynomial ^ 3 - C (16 / 9) * mThreePolynomial ^ 3 * dyPolynomial

def xAbovePolynomial : MvPolynomial (Fin 2) ℚ := nxPolynomial - C (24 / 625) * dxPolynomial
def yAbovePolynomial : MvPolynomial (Fin 2) ℚ := nyPolynomial - C (24 / 625) * dyPolynomial
def sumBelowPolynomial : MvPolynomial (Fin 2) ℚ :=
  dxPolynomial * dyPolynomial - nxPolynomial * dyPolynomial - nyPolynomial * dxPolynomial
def productAbovePolynomial : MvPolynomial (Fin 2) ℚ := nxPolynomial * nyPolynomial - C (24 / 625) * dxPolynomial * dyPolynomial

