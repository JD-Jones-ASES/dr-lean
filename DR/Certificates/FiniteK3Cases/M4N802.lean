  refine ⟨equations_checked,?_⟩
  intro s
  have hk := kernels_checked s
  rw [← finiteK3EnvelopeFlatB_eq_table coeff 4 802 (by decide) (by decide) s] at hk
  fin_cases s
  · refine ⟨?_,?_,hk⟩
