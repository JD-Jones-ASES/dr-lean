private theorem equations_checked : FiniteK3EnvelopeEquations 4 100 coeff := by
  exact finiteK3EnvelopeEquations_of_integer 4 100 denominator (numerators.get 0) numerators.get
    (by decide) (by decide +kernel) integer_equations_checked

