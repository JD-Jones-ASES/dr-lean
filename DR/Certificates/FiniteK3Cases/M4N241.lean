  finiteK3EnvelopeIntegerEquations_of_sparse _ _ _ sparse_equations_checked

private theorem equations_checked : FiniteK3EnvelopeEquations 4 241 coeff := by
  exact finiteK3EnvelopeEquations_of_integer 4 241 denominator (numerators.get 0) numerators.get
