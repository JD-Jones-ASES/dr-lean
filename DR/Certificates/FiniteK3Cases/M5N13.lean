theorem valid : FiniteK3EnvelopeValid 5 13 (by decide) coeff := by
  refine ⟨equations_checked,?_⟩
  intro s
  have hk := kernels_checked s
  rw [← finiteK3EnvelopeFlatB_eq_table coeff 5 13 (by decide) (by decide) s] at hk
  fin_cases s
  · refine ⟨?_,?_,hk⟩
    · rw [finiteK3EnvelopeH_eq_table coeff 5 (by decide) (by decide)]
      exact h0Gram.strictValid_posDef _ h0_checked
    · rw [finiteK3EnvelopeB0_eq_table coeff 5 13 (by decide) (by decide)]
      exact b0Gram.strictValid_posDef _ b0_checked
  · refine ⟨?_,?_,hk⟩
    · rw [finiteK3EnvelopeH_eq_table coeff 5 (by decide) (by decide)]
      exact h1Gram.strictValid_posDef _ h1_checked
    · rw [finiteK3EnvelopeB0_eq_table coeff 5 13 (by decide) (by decide)]
