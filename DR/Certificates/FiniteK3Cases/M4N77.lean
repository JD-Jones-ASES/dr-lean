theorem valid : FiniteK3EnvelopeValid 4 77 (by decide) coeff := by
  refine ⟨equations_checked,?_⟩
  intro s
  have hk := kernels_checked s
  rw [← finiteK3EnvelopeFlatB_eq_table coeff 4 77 (by decide) (by decide) s] at hk
  fin_cases s
  · refine ⟨?_,?_,hk⟩
    · rw [finiteK3EnvelopeH_eq_table coeff 4 (by decide) (by decide)]
      exact h0Gram.strictValid_posDef _ h0_checked
    · rw [finiteK3EnvelopeB0_eq_table coeff 4 77 (by decide) (by decide)]
