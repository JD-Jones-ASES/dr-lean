theorem fourRowFinite50Block22_actualEntry_clear (u : ℝ) (_hu : 1/10 ≤ u ∧ u ≤ 1) :
    fourRowFiniteMatrixPolynomial (fun k i j => fourRowFinite50Block22Power i j k) u =
      fourRowFiniteDenominator 50 u • fourRowFinite50Block22ActualEntry u := by
  ext i j
  change rationalEval (fun _ => u) (powerPolynomial (fourRowFinite50Block22Power i j)) =
    fourRowFiniteDenominator 50 u*fourRowFinite50Block22ActualEntry u i j
  rw [fourRowFinite50Block22_polynomial_actual]
  rw [fourRowFiniteColumnStandardPolynomial_eval ]
  simp_rw [fourRowFiniteFamilyRolePolynomial_eval]
  rfl

theorem fourRowFinite50Block22_actualEntry_posDef (u : ℝ) (hu : 1/10 ≤ u ∧ u ≤ 1) :
    (fourRowFinite50Block22ActualEntry u).PosDef := by
  have hp := fourRowFinite50Block22Polynomial_posDef u hu
  rw [fourRowFinite50Block22_actualEntry_clear u hu] at hp
  have hD := fourRowFiniteDenominator_pos (by norm_num : (5 : ℝ) ≤ 50) hu.2
  have h := hp.smul (inv_pos.mpr hD)
  simpa only [smul_smul, inv_mul_cancel₀ hD.ne', one_smul] using h

