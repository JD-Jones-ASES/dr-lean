theorem fourRowFinite50Block22_power_actual : ∀ i j : Fin 3, ∀ d : Fin 10,
    fourRowFinite50Block22Power i j d = fourRowFinitePowerPad (fourRowFinite50Block22ActualPower i j) d := by
  decide +kernel

theorem fourRowFinite50Block22_polynomial_actual (i j : Fin 3) :
