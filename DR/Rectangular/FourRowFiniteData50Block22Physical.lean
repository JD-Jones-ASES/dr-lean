      fourRowFiniteColumnStandardPolynomial 2 1 50
      (fourRowFiniteFamilyRolePolynomial fourRowFiniteFamilyNumerator50)
      [(0,0),(0,1),(1,0)] i.val j.val := by
  have he := funext (fourRowFinite50Block22_power_actual i j)
  rw [he, fourRowFinitePowerPad_polynomial]
  exact fourRowFiniteColumnStandardPower_polynomial 2 1 50 _ _ i.val j.val

def fourRowFinite50Block22ActualEntry (u : ℝ) : Matrix (Fin 3) (Fin 3) ℝ := fun i j =>
  fourRowFiniteColumnStandardEntry 2 2
    (fun key => fourRowFiniteNumeratorValue fourRowFiniteFamilyNumerator50 (fourRowFiniteRoleLookup key) u)
