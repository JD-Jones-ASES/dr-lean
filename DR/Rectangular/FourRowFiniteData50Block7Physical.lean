  have hp := fourRowFinite50Block7Polynomial_posDef u hu
  rw [fourRowFinite50Block7_actualEntry_clear u hu] at hp
  have hD := fourRowFiniteDenominator_pos (by norm_num : (5 : ℝ) ≤ 50) hu.2
